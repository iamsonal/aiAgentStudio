{
    "orgName": "aiAgentStudio",
    "edition": "Developer",
    "features": ["Knowledge", "LightningServiceConsole", "Communities", "LiveAgent", "ServiceCloud", "EnableSetPasswordInApi"],
    "settings": {
        "communitiesSettings": {
            "enableNetworksEnabled": false
        },
        "liveAgentSettings": {
            "enableLiveAgent": false
        },
        "knowledgeSettings": {
            "enableKnowledge": true,
            "enableLightningKnowledge": true
        },
        "lightningExperienceSettings": {
            "enableS1DesktopEnabled": true
        },
        "mobileSettings": {
            "enableS1EncryptedStoragePref2": false
        },
        "pathAssistantSettings": {
            "pathAssistantEnabled": true
        },
        "languageSettings": {
            "enableTranslationWorkbench": true
        },
        "deploymentSettings": {
            "doesSkipAsyncApexValidation": true
        }
    }
}
