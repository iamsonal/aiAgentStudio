    <required>true</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>User</fullName>
                <default>false</default>
                <label>User</label>
            </value>
            <value>
                <fullName>Queue</fullName>
                <default>false</default>
                <label>Queue</label>
            </value>
            <value>
                <fullName>Anchor Record Owner</fullName>
                <default>false</default>
                <label>Anchor Record Owner</label>
            </value>
            <value>
                <fullName>Requester&apos;s Manager</fullName>
                <default>false</default>
                <label>Requester&apos;s Manager</label>
            </value>
            <value>
                <fullName>Delivery Channel</fullName>
                <default>false</default>
                <label>Approval Process</label>
            </value>
        </valueSetDefinition>
