<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ExpiryAction__c</fullName>
    <description>Copied from the tool: what Core does if nobody decides before the deadline.</description>
    <inlineHelpText>Deny and Continue tells the agent the call was not approved and lets it continue. Pause for Operator pauses the run for an administrator.</inlineHelpText>
    <label>When Approval Expires</label>
    <required>true</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Deny and Continue</fullName>
                <default>true</default>
                <label>Deny and Continue</label>
            </value>
            <value>
                <fullName>Pause for Operator</fullName>
                <default>false</default>
                <label>Pause for Operator</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
