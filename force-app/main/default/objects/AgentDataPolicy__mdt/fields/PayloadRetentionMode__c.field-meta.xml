<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PayloadRetentionMode__c</fullName>
    <description>Protection and retention mode applied to payloads for newly started runs.</description>
    <fieldManageability>SubscriberControlled</fieldManageability>
    <inlineHelpText>Leave blank to use Redacted. Full retains raw content; Hash Only and None minimize stored content.</inlineHelpText>
    <label>Payload Retention Mode</label>
    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Redacted</fullName>
                <default>true</default>
                <label>Redacted</label>
            </value>
            <value>
                <fullName>Full</fullName>
                <default>false</default>
                <label>Full</label>
            </value>
            <value>
                <fullName>Hash Only</fullName>
                <default>false</default>
                <label>Hash Only</label>
            </value>
            <value>
                <fullName>None</fullName>
                <default>false</default>
                <label>None</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
