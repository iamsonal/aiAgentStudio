{
    "name": "salesforce-app",
    "private": true,
    "license": "AGPL-3.0-only",
    "version": "1.0.0",
    "description": "Salesforce App",
    "scripts": {
        "prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,yaml,yml}\"",
        "prettier:verify": "prettier --check \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,yaml,yml}\"",
        "lint": "eslint **/{aura,lwc}/**/*.js",
        "prepare": "husky",
        "audit:field-documentation": "node scripts/check-field-documentation.js",
        "audit:dependencies": "npm audit --audit-level=moderate",
        "deploy:agent-core": "bash scripts/deploy-agent-core.sh",
        "deploy:test-fixtures": "bash scripts/deploy-test-fixtures.sh",
        "deploy:agent-hitl": "bash scripts/deploy-package.sh packages/agent-hitl",
        "deploy:pluto-model-adapters": "bash scripts/deploy-package.sh pluto-model-adapters",
        "deploy:agent-service-user-setup": "bash -c 'sf project deploy start --source-dir packages/agent-service-user-setup --wait 60 ${0:+--target-org \"$0\"}'",
        "deploy:agent-channels": "bash scripts/deploy-package.sh packages/agent-channels",
        "deploy:agent-tools": "bash scripts/deploy-package.sh packages/agent-tools",
        "deploy:pluto-console": "bash scripts/deploy-package.sh pluto-console",
        "deploy:agent-testing-kit": "bash scripts/deploy-agent-testing-kit.sh",
        "validate:agent-core": "bash scripts/deploy-agent-core.sh '' validate",
        "validate:pluto-model-adapters": "bash scripts/deploy-package.sh pluto-model-adapters '' validate",
        "validate:agent-hitl": "bash scripts/deploy-package.sh packages/agent-hitl '' validate",
        "validate:agent-channels": "bash scripts/deploy-package.sh packages/agent-channels '' validate",
        "validate:agent-tools": "bash scripts/deploy-package.sh packages/agent-tools '' validate",
        "validate:pluto-console": "bash scripts/deploy-package.sh pluto-console '' validate",
        "validate:agent-testing-kit": "bash scripts/deploy-agent-testing-kit.sh '' validate",
        "test": "npm run test:unit",
        "test:unit": "sfdx-lwc-jest",
        "test:unit:watch": "sfdx-lwc-jest --watch",
        "test:unit:debug": "sfdx-lwc-jest --debug",
        "test:unit:coverage": "sfdx-lwc-jest --coverage",
        "test:apex:agent-core": "bash scripts/run-core-coverage.sh",
        "test:apex:agent-hitl": "bash scripts/test-package.sh packages/agent-hitl",
        "test:apex:pluto-model-adapters": "bash scripts/test-package.sh pluto-model-adapters",
        "test:apex:agent-channels": "bash scripts/test-package.sh packages/agent-channels",
        "test:apex:agent-tools": "bash scripts/test-package.sh packages/agent-tools",
        "test:apex:pluto-console": "bash scripts/test-package.sh pluto-console",
        "code-analyzer": "sf code-analyzer run --rule-selector AppExchange --rule-selector \"Recommended:Security\" --target \"force-app/**/*.cls\" --target \"packages/**/*.cls\" --output-file code-analyzer.csv && node scripts/check-code-analyzer-results.js code-analyzer.csv",
        "verify:agent-core:static": "bash scripts/verify-agent-core-static.sh",
        "release:verify:agent-core": "bash scripts/verify-agent-core-release.sh",
        "seed:agent-testing-kit": "cci task run load_agent_testing_kit_samples --org",
        "cleanup:agent-testing-kit": "cci task run delete_agent_testing_kit_sample_records --org",
        "smoke:agent-testing-kit": "bash scripts/smoke-agent-testing-kit.sh",
        "eval:agent-testing-kit": "bash scripts/eval-agent-testing-kit.sh",
        "set:api-version": "bash scripts/set-api-version.sh",
        "license:headers": "node scripts/license-headers.js",
        "license:check": "node scripts/license-headers.js --check",
        "build:micromark": "rollup --config scripts/rollup.micromark.config.mjs",
        "publish:public": "bash scripts/publish-public.sh"
    },
    "devDependencies": {
        "@lwc/eslint-plugin-lwc": "^3.0.0",
        "@prettier/plugin-xml": "^3.4.1",
        "@sa11y/jest": "^7.1.2",
        "@salesforce/eslint-config-lwc": "^4.0.0",
        "@salesforce/eslint-plugin-lightning": "^2.0.0",
        "@salesforce/sfdx-lwc-jest": "^7.0.2",
        "eslint": "^9.28.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jest": "^28.12.0",
        "husky": "^9.1.7",
        "jest-canvas-mock": "^2.5.2",
        "prettier": "^3.5.3",
        "prettier-plugin-apex": "^2.2.6",
        "rollup": "^4.63.1"
    },
    "optionalDependencies": {
        "@prettier-apex/apex-ast-serializer-darwin-arm64": "^2.3.0"
    }
}
