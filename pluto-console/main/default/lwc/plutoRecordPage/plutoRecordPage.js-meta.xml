    <masterLabel>Pluto Record Editor</masterLabel>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>AgentDefinition__c</object>
                <object>AgentTool__c</object>
                <object>AgentContextProvider__c</object>
                <object>AgentExecutionIdentity__c</object>
            </objects>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
